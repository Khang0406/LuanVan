FLASK_SECRET_KEY=change-me
PLATFORM_ENV=development
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8000
# URL public dùng trong liên kết email; bắt buộc đặt đúng host HTTPS khi deploy.
# PLATFORM_PUBLIC_URL=https://platform.example.com
TRUST_PROXY_COUNT=0
PIPELINE_MAX_CONCURRENT=4
PIPELINE_POLL_INTERVAL=2
PIPELINE_LEASE_SECONDS=300
PIPELINE_HEARTBEAT_SECONDS=30
PIPELINE_TASK_SOFT_TIME_LIMIT=3300
PIPELINE_TASK_TIME_LIMIT=3600
CELERY_VISIBILITY_TIMEOUT=7200
CELERY_RESULT_EXPIRES=86400
TEST_CONTAINER_MEMORY_LIMIT=512m
TEST_CONTAINER_CPU_LIMIT=1.0
TEST_CONTAINER_PIDS_LIMIT=256
CONTAINER_HEALTH_PROBE_IMAGE=curlimages/curl:8.10.1
# Production bootstrap only; keep real values in a secret, never in .env/git.
# PLATFORM_ADMIN_USERNAME=admin
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_DEV_PASSWORD=
# COOKIE_SECURE=true

# Tách Docker build/test/push sang Build Worker qua SSH.
# Không mount /var/run/docker.sock vào container Platform.
# DOCKER_HOST=ssh://platform-builder@10.0.0.20
# DOCKER_SSH_COMMAND=ssh -i /run/secrets/builder/id_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=/run/secrets/builder/known_hosts
# DOCKER_BUILDKIT=1

# Khi chạy Platform trong container/K3s, cả SQLAlchemy và delivery store phải
# trỏ vào cùng volume bền vững.
# DATABASE_URL=sqlite:////var/lib/platform/app.db
# PostgreSQL production schema phải được tạo/nâng cấp trước khi start web:
# python scripts/manage_database.py upgrade
# DELIVERY_DATABASE_PATH=/var/lib/platform/app.db
# PLATFORM_DATA_DIR=/var/lib/platform

# Prometheus & Grafana (NodePort services on K3s cluster)
# Thay IP bằng master_ip của cluster đang dùng
PROMETHEUS_URL=http://35.198.237.48:30900
GRAFANA_URL=http://35.198.237.48:30300
GRAFANA_API_KEY=

# SMTP production: lưu giá trị thật bằng Kubernetes Secret, không dùng .env Git.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_TO=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SMTP_TIMEOUT=10
# EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=3600
# EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5
# EMAIL_VERIFICATION_MAX_SENDS_PER_IP_HOUR=20
